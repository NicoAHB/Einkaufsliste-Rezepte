  "recipes": [
    {
      "id": "recipe-pasta",
      "name": "Tomaten-Pasta",
      "servings": 2,
      "tags": [
        "schnell",
        "vegetarisch"
      ],
      "instructions": "Nudeln in Salzwasser kochen. Zwiebel würfeln und in Olivenöl anbraten. Tomaten dazugeben, 10 Minuten köcheln lassen und würzen. Mit den Nudeln vermischen.",
      "createdAt": "2026-10-25T00:00:00.000Z",
      "updatedAt": "2026-10-25T00:00:00.000Z",
      "deletedAt": null,
      "_clock": {}
    },
    {
      "id": "recipe-curry",
      "name": "Kichererbsen-Curry",
      "servings": 2,
      "tags": [
        "vegan",
        "einfach"
      ],
      "instructions": "Reis kochen. Paprika würfeln und kurz anbraten. Abgetropfte Kichererbsen, Kokosmilch und Currypulver zugeben. 15 Minuten köcheln lassen und mit dem Reis servieren.",
      "createdAt": "2026-10-25T00:00:00.000Z",
      "updatedAt": "2026-10-25T00:00:00.000Z",
      "deletedAt": null,
      "_clock": {}
    },
    {
      "id": "recipe-pfannkuchen",
      "name": "Apfel-Pfannkuchen",
      "servings": 2,
      "tags": [
        "vegetarisch",
        "süß"
      ],
      "instructions": "Mehl, Milch und Eier zu einem Teig verrühren. Apfel in dünne Scheiben schneiden. Etwas Butter in einer Pfanne erhitzen. Teig und Apfelscheiben hineingeben, von beiden Seiten goldbraun backen.",
      "createdAt": "2026-10-25T00:00:00.000Z",
      "updatedAt": "2026-10-25T00:00:00.000Z",
      "deletedAt": null,
      "_clock": {}
    }
  ],
